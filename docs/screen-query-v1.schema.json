{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cleat.dev/schemas/screen-query-v1.json",
  "title": "Cleat screen query v1",
  "type": "object",
  "required": [
    "schema_version",
    "selector_syntax",
    "producer",
    "generation",
    "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "selector_syntax": {
      "const": "stable"
    },
    "producer": {
      "const": "graph"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parent",
        "children",
        "element",
        "roles",
        "attributes",
        "bounds",
        "text",
        "confidence",
        "captures"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "parent": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "children": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "element": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "properties": {
            "provenance": {
              "enum": [
                "declared",
                "structural",
                "graph",
                "temporal",
                "learned"
              ]
            },
            "evidence": {
              "type": "string"
            }
          }
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "col",
            "row",
            "width",
            "height"
          ],
          "properties": {
            "col": {
              "type": "integer",
              "minimum": 0
            },
            "row": {
              "type": "integer",
              "minimum": 0
            },
            "width": {
              "type": "integer",
              "minimum": 0
            },
            "height": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "text": {
          "type": "string"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "captures": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
